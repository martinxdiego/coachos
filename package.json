    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.1",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "^5.10.1",
    "lucide-react": "0.468.0",
    "next": "15.5.23",
