# --- Database ---
# Runtime connection used by the app (Supabase pooler, PgBouncer transaction
# mode, port 6543). Safe for serverless / many short-lived connections.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# DIRECT connection used ONLY by the Prisma CLI for migrations (port 5432).
# The pooled URL above hangs on `prisma migrate`; set this to the direct
# connection string. If unset, the CLI falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional TLS CA override. When empty, the bundled Supabase root CA is used.
# Preserve PEM line breaks or encode them as literal \n; both are supported.
DATABASE_CA_CERT=

# --- Supabase (Storage only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose this value through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRIVACY_URL=https://example.com/datenschutz
# Public legal pages are included at /legal/*. Fill these server-only values
# before publishing; do not leave the placeholders visible in production.
LEGAL_OPERATOR_NAME=CoachOS Betreibername
LEGAL_OPERATOR_ADDRESS=Strasse 1\n8000 Zürich\nSchweiz
LEGAL_CONTACT_EMAIL=legal@your-domain.example
# Enable indexing only after the legal text has been reviewed and completed.
LEGAL_PUBLISH=false

# --- Authentication and scheduled jobs (required in production) ---
AUTH_SECRET=generate-a-long-random-secret
# Required for a trusted reverse proxy/custom production host. The proxy must
# overwrite, not append, Forwarded/X-Forwarded-Host headers.
AUTH_TRUST_HOST=true
CRON_SECRET=generate-a-separate-long-random-secret
# Pilot gate for creating coach accounts. Use at least 16 random characters.
COACH_SIGNUP_CODE=generate-a-separate-pilot-invite-code

# --- Push notifications (required when push is enabled) ---
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Rate limiting (required for a multi-instance production deployment) ---
REDIS_URL=rediss://...

# --- Optional integrations ---
# ANTHROPIC_API_KEY=                        # AI draft generation
# ANTHROPIC_MODEL=claude-sonnet-5           # pinned/configurable model id
# SENTRY_DSN=                               # error aggregation (S4.3)
# RESEND_API_KEY=                           # Passwort-Reset-E-Mails
# EMAIL_FROM=CoachOS <support@your-domain.example>
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
# EMAIL_VERIFICATION_REQUIRED=false         # true for public self-service

# --- Optional Stripe billing ---
# Keep BILLING_ENFORCE=false during the free pilot. Set it to true only after
# Checkout, portal and signed webhooks have been verified in Stripe test mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# PRO_PRICE_DISPLAY=CHF 12 / Monat
# BILLING_ENFORCE=false
